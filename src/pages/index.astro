---
import Layout from "~/layouts/PageLayout.astro";

import Hero from "~/components/widgets/Hero.astro";
import Note from "~/components/widgets/Note.astro";
import Features from "~/components/widgets/Features.astro";
import Content from "~/components/widgets/Content.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";

const metadata = {
  title: "Oumaima El Ghalbouni | Data Engineering Portfolio",
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- ===================================================== -->
  <!-- HERO -->
  <!-- ===================================================== -->

  <Hero
    actions={[
      {
        variant: "primary",
        text: "Download CV",
        href: "/resume.pdf",
        target: "_blank",
        icon: "tabler:file-download",
      },
      {
        text: "View Projects",
        href: "#projects",
      },
    ]}
    image={{
      src: "~/assets/images/hero-image.png",
      alt: "Oumaima El Ghalbouni - Data Engineering Portfolio",
    }}
  >
    <Fragment slot="title">
      Building
      <span class="text-accent dark:text-white">
        Data-Driven Systems
      </span>
      & Intelligent Applications
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold text-blue-600">
        Oumaima El Ghalbouni
      </span>
      — Final-year Data Engineering student (BAC+5) passionate about
      <span class="font-semibold">
        Data Engineering, Data Science, and Artificial Intelligence
      </span>.
      I build solutions that collect, process, analyze, and transform data
      into useful insights and intelligent applications using
      <span class="font-semibold">
        Python, SQL, Big Data technologies, Machine Learning, and RAG.
      </span>
    </Fragment>
  </Hero>


  <!-- ===================================================== -->
  <!-- MISSION -->
  <!-- ===================================================== -->

  <Note
    title="What I Build:"
    description="Data pipelines, analytical platforms, machine learning applications, real-time data systems, dashboards, and AI-powered applications — from data ingestion and processing to visualization and intelligent decision support."
  />


  <!-- ===================================================== -->
  <!-- SKILLS -->
  <!-- ===================================================== -->

  <Features
    id="skills"
    tagline="Technical Stack"
    title="Skills & Technologies"
    subtitle="Technologies I have applied through academic projects, internships, and continuous learning."
    items={[
      {
        title: "Data Engineering & Big Data",
        description:
          "Building ETL/ELT pipelines, data processing workflows, data lakes, data warehouses, and distributed systems using Kafka, Spark, Flink, Hadoop, Airflow, MinIO, and related technologies.",
        icon: "tabler:database-cog",
      },
      {
        title: "Data Science & Machine Learning",
        description:
          "Data preprocessing, feature engineering, model training and evaluation using Python, Pandas, NumPy, Scikit-learn, TensorFlow, and PyTorch.",
        icon: "tabler:brain",
      },
      {
        title: "Artificial Intelligence & RAG",
        description:
          "Exploring NLP, Large Language Model applications, Retrieval-Augmented Generation, vector search, document question answering, and intelligent assistants.",
        icon: "tabler:sparkles",
      },
      {
        title: "Databases & Data Storage",
        description:
          "Working with PostgreSQL, MySQL, SQL Server, Oracle, MongoDB, Cassandra, Elasticsearch, and object storage such as MinIO.",
        icon: "tabler:database",
      },
      {
        title: "Analytics & Business Intelligence",
        description:
          "Creating analytical dashboards and KPIs using Power BI, DAX, Excel, Matplotlib, Dash, and Plotly.",
        icon: "tabler:chart-bar",
      },
      {
        title: "APIs & Applications",
        description:
          "Developing data-oriented applications and REST APIs using FastAPI, Flask, Streamlit, Spring Boot, PHP, JavaScript, HTML, and CSS.",
        icon: "tabler:api",
      },
      {
        title: "Cloud, DevOps & Tools",
        description:
          "Using Docker, Git, GitHub, Linux, and Oracle Cloud concepts to develop and manage reproducible data applications.",
        icon: "tabler:brand-docker",
      },
      {
        title: "Programming",
        description:
          "Python, SQL, Java, C, PHP, HTML, CSS, and JavaScript, with Python and SQL as my main tools for data-related work.",
        icon: "tabler:code",
      },
    ]}
  />


  <!-- ===================================================== -->
  <!-- ABOUT -->
  <!-- ===================================================== -->

  <Content
    id="about"
    isReversed
    tagline="Profile"
    title="From Data Engineering to Artificial Intelligence"
    items={[
      {
        title: "Engineering Student",
        description:
          "Currently completing my final year of the Data Engineering engineering cycle at ENSA Al Hoceima, with coursework and projects covering Big Data, distributed systems, databases, AI, machine learning, and business intelligence.",
      },
      {
        title: "Hands-On Experience",
        description:
          "My internships and projects allowed me to work on data pipelines, Power BI dashboards, machine learning systems, cybersecurity analytics, real-time data processing, and AI-powered applications.",
      },
      {
        title: "Continuous Learning",
        description:
          "Currently deepening my knowledge of Retrieval-Augmented Generation and Agentic AI while continuing to strengthen my Data Engineering and Machine Learning skills.",
      },
    ]}
    image={{
      src: "https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=2070&q=80",
      alt: "Data and technology collaboration",
    }}
  >
    <Fragment slot="content">
      <h3
        class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2"
      >
        Building Complete Data Solutions
      </h3>

      I enjoy working across the complete data lifecycle — from data
      collection and ingestion to storage, processing, analysis,
      visualization, machine learning, and intelligent applications.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>


  <!-- ===================================================== -->
  <!-- EXPERIENCE -->
  <!-- ===================================================== -->

  <Features
    id="experience"
    tagline="Professional Experience"
    title="Internships & Industry Experience"
    subtitle="Selected professional experiences where I applied data, analytics, AI, and software technologies to real-world problems."
    items={[
      {
        title: "AI & Data Scientist Intern — CMRPI",
        description:
          "Developed an end-to-end phishing URL detection pipeline using machine learning and Elasticsearch. Benchmarked four ML models with 5-fold cross-validation, achieving over 90% precision and recall, and built a 5-page Streamlit monitoring dashboard with automated email alerts.",
        icon: "tabler:shield-check",
      },
      {
        title: "Data Analyst Intern — Terra Nova EBS",
        description:
          "Designed four-page Power BI dashboards for the Procurement Department, developed DAX measures and calculated columns, and cleaned and transformed business datasets using Excel and Power BI.",
        icon: "tabler:chart-dots",
      },
      {
        title: "Web Development Intern — Provincial Hospital Center Med VI",
        description:
          "Designed and implemented administrative and employee modules for a web application supporting the digitalization of radiology department operations.",
        icon: "tabler:building-hospital",
      },
    ]}
  />


  <!-- ===================================================== -->
  <!-- EXPERIENCE DETAILS -->
  <!-- ===================================================== -->

  <section class="py-10">
    <div class="max-w-5xl mx-auto px-4">

      <div class="grid md:grid-cols-3 gap-6">

        <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 shadow-md">
          <div class="flex items-center gap-3 mb-3">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30">
              <span class="text-blue-600" aria-hidden="true">
                <iconify-icon icon="tabler:shield-check" />
              </span>
            </div>
            <span class="text-sm text-blue-600 font-semibold">
              07/2026 – 08/2026
            </span>
          </div>

          <h3 class="font-bold text-lg dark:text-white">
            AI & Data Scientist Intern
          </h3>

          <p class="text-sm text-gray-500 mt-1">
            Moroccan Center for Polytechnic Research and Innovation
          </p>

          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3">
            Phishing detection, machine learning, Elasticsearch,
            Streamlit monitoring, threat intelligence and automated alerts.
          </p>
        </div>


        <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 shadow-md">
          <div class="flex items-center gap-3 mb-3">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30">
              <span class="text-blue-600" aria-hidden="true">
                <iconify-icon icon="tabler:chart-bar" />
              </span>
            </div>

            <span class="text-sm text-blue-600 font-semibold">
              07/2025 – 08/2025
            </span>
          </div>

          <h3 class="font-bold text-lg dark:text-white">
            Data Analyst Intern
          </h3>

          <p class="text-sm text-gray-500 mt-1">
            Terra Nova EBS
          </p>

          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3">
            Power BI dashboards, DAX, Excel, data cleaning,
            transformation and procurement analytics.
          </p>
        </div>


        <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 shadow-md">
          <div class="flex items-center gap-3 mb-3">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30">
              <span class="text-blue-600" aria-hidden="true">
                <iconify-icon icon="tabler:building-hospital" />
              </span>
            </div>

            <span class="text-sm text-blue-600 font-semibold">
              06/2025 – 09/2025
            </span>
          </div>

          <h3 class="font-bold text-lg dark:text-white">
            Web Development Intern
          </h3>

          <p class="text-sm text-gray-500 mt-1">
            Provincial Hospital Center Med VI
          </p>

          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3">
            Radiology management application using PHP, MySQL,
            JavaScript, HTML and CSS.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- ===================================================== -->
  <!-- EDUCATION -->
  <!-- ===================================================== -->

  <section id="education" class="py-16 bg-gray-50 dark:bg-gray-900">

    <div class="max-w-6xl mx-auto px-4">

      <h2 class="text-3xl font-bold text-center mb-3 dark:text-white">
        Education
      </h2>

      <p class="text-center text-gray-500 mb-12">
        My academic path in engineering, data, and computer science.
      </p>


      <div class="relative border-l-2 border-blue-600 dark:border-blue-400 ml-4">


        <!-- Engineering -->
        <div class="mb-12 ml-8 relative">

          <span
            class="absolute -left-[46px] top-0 flex items-center justify-center w-8 h-8 rounded-full bg-blue-600 ring-4 ring-gray-50 dark:ring-gray-900"
          >
            <iconify-icon
              icon="tabler:school"
              class="text-white"
            />
          </span>

          <span class="text-sm text-blue-600 font-semibold">
            2024 – Present
          </span>

          <h3 class="text-xl font-bold mt-1 dark:text-white">
            Engineering Degree — Data Engineering
          </h3>

          <p class="font-medium text-gray-600 dark:text-gray-300">
            École Nationale des Sciences Appliquées d'Al-Hoceima (ENSAH)
          </p>

          <p class="text-gray-500 dark:text-gray-400 mt-2">
            Final-year engineering cycle focused on Data Engineering,
            Big Data, distributed systems, Artificial Intelligence,
            Machine Learning, databases, and Business Intelligence.
          </p>

        </div>


        <!-- Preparatory Cycle -->
        <div class="mb-12 ml-8 relative">

          <span
            class="absolute -left-[46px] top-0 flex items-center justify-center w-8 h-8 rounded-full bg-purple-600 ring-4 ring-gray-50 dark:ring-gray-900"
          >
            <iconify-icon
              icon="tabler:books"
              class="text-white"
            />
          </span>

          <span class="text-sm text-purple-600 font-semibold">
            2022 – 2024
          </span>

          <h3 class="text-xl font-bold mt-1 dark:text-white">
            Preparatory Cycle
          </h3>

          <p class="font-medium text-gray-600 dark:text-gray-300">
            École Nationale des Sciences Appliquées d'Al-Hoceima
          </p>

          <p class="text-gray-500 dark:text-gray-400 mt-2">
            Scientific and technical foundation in mathematics,
            programming, algorithms, computer science, and engineering.
          </p>

        </div>


        <!-- Bac -->
        <div class="ml-8 relative">

          <span
            class="absolute -left-[46px] top-0 flex items-center justify-center w-8 h-8 rounded-full bg-pink-600 ring-4 ring-gray-50 dark:ring-gray-900"
          >
            <iconify-icon
              icon="tabler:certificate"
              class="text-white"
            />
          </span>

          <span class="text-sm text-pink-600 font-semibold">
            2022
          </span>

          <h3 class="text-xl font-bold mt-1 dark:text-white">
            Baccalaureate — Physics & Chemistry
          </h3>

          <p class="font-medium text-gray-600 dark:text-gray-300">
            Lycée Rif, Ajdir
          </p>

          <p class="text-gray-500 dark:text-gray-400 mt-2">
            French option.
          </p>

        </div>

      </div>
    </div>
  </section>


  <!-- ===================================================== -->
  <!-- PROJECTS -->
  <!-- ===================================================== -->

  <section id="projects" class="py-20">

    <div class="max-w-6xl mx-auto px-4">

      <div class="text-center mb-12">

        <p class="text-blue-600 font-semibold uppercase tracking-wide">
          Portfolio
        </p>

        <h2 class="text-4xl md:text-5xl font-bold mt-2 dark:text-white">
          Projects
        </h2>

        <p class="text-gray-500 max-w-3xl mx-auto mt-4">
          A collection of academic, internship, and personal projects
          covering Data Engineering, Big Data, Machine Learning,
          Artificial Intelligence, analytics, databases, and application
          development.
        </p>

      </div>


      <div class="grid md:grid-cols-2 gap-8">


        <!-- ================================================= -->
        <!-- PHISHING -->
        <!-- ================================================= -->

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden">

          <img
            src="/images/phishing.png"
            alt="Phishing Early Warning System"
            class="w-full h-48 object-cover"
          />

          <div class="p-6">

            <div class="flex justify-between items-start gap-3">

              <h3 class="text-xl font-bold dark:text-white">
                Phishing Early Warning System
              </h3>

              <span class="text-xs px-2 py-1 rounded-full bg-blue-100 text-blue-700">
                PFA
              </span>

            </div>

            <p class="text-sm text-blue-600 mt-2">
              Python • XGBoost • Machine Learning • Streamlit
            </p>

            <p class="text-gray-600 dark:text-gray-300 mt-4">
              Built an early warning system for phishing threats targeting
              SMEs. Developed a machine learning pipeline using
              188,296 samples and integrated threat analysis with a
              monitoring interface and email notifications.
            </p>

            <div class="flex gap-3 mt-5">

              <a
                href="https://github.com/elghalbouni-oumaima"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700"
              >
                GitHub ↗
              </a>

            </div>

          </div>
        </div>


        <!-- ================================================= -->
        <!-- MEETING ASSISTANT -->
        <!-- ================================================= -->

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden">

          <img
            src="/images/meeting-assistant.png"
            alt="AI Meeting Assistant"
            class="w-full h-48 object-cover"
          />

          <div class="p-6">

            <h3 class="text-xl font-bold dark:text-white">
              AI Meeting Assistant
            </h3>

            <p class="text-sm text-blue-600 mt-2">
              NLP • RAG • FAISS • HuggingFace • Streamlit
            </p>

            <p class="text-gray-600 dark:text-gray-300 mt-4">
              Developed an intelligent application for analyzing meeting
              transcripts, generating summaries and action plans,
              performing sentiment analysis by speaker, and answering
              questions over meeting documents using RAG and FAISS.
            </p>

            <div class="flex gap-3 mt-5">

              <a
                href="https://github.com/elghalbouni-oumaima/meeting-assistant"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700"
              >
                GitHub ↗
              </a>

            </div>

          </div>
        </div>


        <!-- ================================================= -->
        <!-- TAASIM -->
        <!-- ================================================= -->

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden">

          <img
            src="/images/taasim.png"
            alt="TaaSim Casablanca Urban Mobility Platform"
            class="w-full h-48 object-cover"
          />

          <div class="p-6">

            <h3 class="text-xl font-bold dark:text-white">
              TaaSim — Real-Time Urban Mobility Platform
            </h3>

            <p class="text-sm text-blue-600 mt-2">
              Kafka • Flink • Spark • Cassandra • FastAPI • Docker
            </p>

            <p class="text-gray-600 dark:text-gray-300 mt-4">
              Designed a Kappa Architecture for real-time urban mobility
              data. Implemented Kafka-based ingestion, Apache Flink
              streaming pipelines, Spark ETL processing, Cassandra
              storage, and machine learning for transportation demand
              forecasting.
            </p>

            <div class="flex gap-3 mt-5">

              <a
                href="https://github.com/elghalbouni-oumaima/taasim-urban-mobility-platform"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700"
              >
                GitHub ↗
              </a>

            </div>

          </div>
        </div>


        <!-- ================================================= -->
        <!-- DATA WAREHOUSE -->
        <!-- ================================================= -->

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden">

          <img
            src="/images/data-warehouse.png"
            alt="End-to-End Data Warehouse"
            class="w-full h-48 object-cover"
          />

          <div class="p-6">

            <h3 class="text-xl font-bold dark:text-white">
              End-to-End Data Warehouse & Churn Analytics
            </h3>

            <p class="text-sm text-blue-600 mt-2">
              SQL Server • Airflow • Python • Power BI • FastAPI
            </p>

            <p class="text-gray-600 dark:text-gray-300 mt-4">
              Designed a Bronze/Silver/Gold data warehouse with a
              dimensional star schema and 19 data-quality checks.
              Built a leakage-free churn prediction pipeline achieving
              97% recall and 0.98 ROC-AUC, then exposed the model through
              FastAPI and Streamlit alongside a Power BI dashboard.
            </p>

            <div class="flex gap-3 mt-5">

              <a
                href="https://github.com/elghalbouni-oumaima/end-to-end-data-warehouse-with-sql"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700"
              >
                GitHub ↗
              </a>

            </div>

          </div>
        </div>


        <!-- ================================================= -->
        <!-- MONGODB -->
        <!-- ================================================= -->

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden">

          <img
            src="/images/mongodb.png"
            alt="MongoDB FHV Trip Data Optimization"
            class="w-full h-48 object-cover"
          />

          <div class="p-6">

            <h3 class="text-xl font-bold dark:text-white">
              FHV Trip Data Optimization
            </h3>

            <p class="text-sm text-blue-600 mt-2">
              MongoDB • Indexing • Sharding • Big Data
            </p>

            <p class="text-gray-600 dark:text-gray-300 mt-4">
              Optimized approximately 16 million FHV trip records using
              MongoDB indexing and sharding, reducing query execution
              time from 61.8 seconds to 7.8 seconds.
            </p>

            <div class="flex gap-3 mt-5">

              <button
                onclick="document.getElementById('mongodb-video-modal').classList.remove('hidden')"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700 transition"
              >
                ▶ Watch Demo
              </button>

              <a
                href="https://github.com/elghalbouni-oumaima/fhv-tripdata-mongodb-optimization"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center border border-gray-300 dark:border-gray-600 px-4 py-2 rounded-lg text-sm hover:bg-gray-100 dark:hover:bg-gray-800 transition"
              >
                GitHub ↗
              </a>

            </div>

          </div>
        </div>


        <!-- ================================================= -->
        <!-- JOBINTELLIGENT -->
        <!-- ================================================= -->

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden">

          <img
            src="/images/job-platform.jpg"
            alt="JobIntelligent Data Platform"
            class="w-full h-48 object-cover"
          />

          <div class="p-6">

            <h3 class="text-xl font-bold dark:text-white">
              JobIntelligent — Job Data Platform
            </h3>

            <p class="text-sm text-blue-600 mt-2">
              APIs • MinIO • PostgreSQL • FastAPI • Power BI
            </p>

            <p class="text-gray-600 dark:text-gray-300 mt-4">
              Built a data platform aggregating job offers from multiple
              APIs. Implemented bronze/silver storage with MinIO,
              PostgreSQL analytical storage, FastAPI services, scheduled
              batch processing, and Power BI dashboards.
            </p>

            <div class="flex gap-3 mt-5">

              <a
                href="https://github.com/firdawss-Elhaddouchi/JobIntelligent-Data-Platform"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700"
              >
                GitHub ↗
              </a>

            </div>

          </div>
        </div>


        <!-- ================================================= -->
        <!-- SIGN LANGUAGE -->
        <!-- ================================================= -->

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden">

          <img
            src="/images/sign-language.png"
            alt="Sign Language Translation"
            class="w-full h-48 object-cover"
          />

          <div class="p-6">

            <h3 class="text-xl font-bold dark:text-white">
              Sign Language Translation
            </h3>

            <p class="text-sm text-blue-600 mt-2">
              Deep Learning • Computer Vision • PyTorch
            </p>

            <p class="text-gray-600 dark:text-gray-300 mt-4">
              Developed a deep learning project for sign language
              translation using the MSKA / Phoenix-2014T dataset.
              Extracted 399 keypoints and trained a sequence-based
              model for continuous sign language recognition.
            </p>

            <div class="flex gap-3 mt-5">

              <a
                href="https://github.com/amina-dourdi/sign-language-translation"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700"
              >
                GitHub ↗
              </a>

            </div>

          </div>
        </div>


        <!-- ================================================= -->
        <!-- PROCUREMENT PIPELINE -->
        <!-- ================================================= -->

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden">

          <img
            src="/images/procurement-pipeline.png"
            alt="Procurement Data Pipeline"
            class="w-full h-48 object-cover"
          />

          <div class="p-6">

            <h3 class="text-xl font-bold dark:text-white">
              Procurement Data Pipeline
            </h3>

            <p class="text-sm text-blue-600 mt-2">
              HDFS • Hive • Trino • PostgreSQL • Avro • Parquet
            </p>

            <p class="text-gray-600 dark:text-gray-300 mt-4">
              Built a batch-oriented data pipeline for procurement
              analytics using HDFS, Hive Metastore, Trino/Presto,
              PostgreSQL, and columnar data formats. Implemented
              data-quality exception handling and date-based reruns.
            </p>

          </div>
        </div>


        <!-- ================================================= -->
        <!-- NLP ANNOTATION -->
        <!-- ================================================= -->

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden">

          <img
            src="/images/annotation.png"
            alt="NLP Annotation Platform"
            class="w-full h-48 object-cover"
          />

          <div class="p-6">

            <h3 class="text-xl font-bold dark:text-white">
              NLP Annotation Platform
            </h3>

            <p class="text-sm text-blue-600 mt-2">
              Spring Boot • Thymeleaf • MariaDB • NLP
            </p>

            <p class="text-gray-600 dark:text-gray-300 mt-4">
