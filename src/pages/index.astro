---
import Layout from "~/layouts/PageLayout.astro";
import Hero from "~/components/widgets/Hero.astro";
import Note from "~/components/widgets/Note.astro";
import Features from "~/components/widgets/Features.astro";
import Content from "~/components/widgets/Content.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";

const metadata = {
  title: "Oumaima El Ghalbouni | Data Engineering Portfolio",
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- ===================================================== -->
  <!-- HERO -->
  <!-- ===================================================== -->

  <Hero
    actions={[
      {
        variant: "primary",
        text: "Download CV",
        href: "/resume.pdf",
        target: "_blank",
        icon: "tabler:file-download",
      },
      {
        text: "View Projects",
        href: "#projects",
      },
    ]}
    image={{
      src: "~/assets/images/hero-image.png",
      alt: "Oumaima El Ghalbouni - Data Engineering Portfolio",
    }}
  >
    <Fragment slot="title">
      Building
      <span class="text-accent dark:text-white">
        Data-Driven Systems
      </span>
      & Intelligent Applications
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold text-blue-600">
        Oumaima El Ghalbouni
      </span>
      — Final-year Data Engineering student. I build pipelines, dashboards,
      and ML/AI applications that turn raw data into decisions.
      <br class="hidden md:block" />
      <span class="inline-flex items-center gap-2 mt-3 text-sm font-medium text-blue-700 bg-blue-50 dark:bg-blue-900/30 dark:text-blue-300 px-3 py-1.5 rounded-full">
        🎯 Seeking a PFE Internship in Data Engineering, BI, or AI
      </span>
    </Fragment>
  </Hero>

  <!-- ===================================================== -->
  <!-- MISSION -->
  <!-- ===================================================== -->

  <Note
    title="What I Build:"
    description="Data pipelines, analytical dashboards, machine learning applications, and AI-powered tools — from ingestion to visualization to decision support."
  />


  <!-- ===================================================== -->
  <!-- SKILLS -->
  <!-- ===================================================== -->

  <Features
    id="skills"
    tagline="Technical Stack"
    title="Skills & Technologies"
    subtitle="Technologies I've applied through academic projects and internships."
    columns={3}
    items={[
      {
        title: "Data Engineering & Big Data",
        description:
          "ETL/ELT pipelines, data lakes and warehouses, and distributed systems with Kafka, Spark, Flink, Hadoop, and Airflow.",
        icon: "tabler:database-cog",
      },
      {
        title: "Machine Learning & AI",
        description:
          "Model training and evaluation with Scikit-learn, TensorFlow, and PyTorch, plus RAG, vector search, and LLM applications.",
        icon: "tabler:brain",
      },
      {
        title: "Databases",
        description:
          "PostgreSQL, MySQL, SQL Server, MongoDB, Cassandra, Elasticsearch, and object storage with MinIO.",
        icon: "tabler:database",
      },
      {
        title: "Analytics & BI",
        description:
          "Dashboards and KPIs with Power BI, Data modeling, DAX, Excel, and Python visualization libraries (Matplotlib, Plotly, Dash).",
        icon: "tabler:chart-bar",
      },
      {
        title: "APIs & Applications",
        description:
          "REST APIs and data apps with FastAPI, Streamlit, and web development with PHP.",
        icon: "tabler:api",
      },
      {
        title: "Cloud & DevOps",
        description:
          "Docker, Git/GitHub, Linux.",
        icon: "tabler:brand-docker",
      },
    ]}
  />


  <!-- ===================================================== -->
  <!-- ABOUT -->
  <!-- ===================================================== -->

  <Content
    id="about"
    isReversed
    tagline="Profile"
    title="From Data Engineering to Artificial Intelligence"
    items={[
      {
        title: "Engineering Student",
        description:
          "Final-year Data Engineering student at ENSA Al Hoceima — Big Data, distributed systems, AI, and Business Intelligence.",
      },
      {
        title: "Hands-On Experience",
        description:
          "Internships spanning data pipelines, Power BI dashboards, ML systems, and cybersecurity analytics.",
      },
      {
        title: "Currently Learning",
        description:
          "Deepening my skills in Data Engineering and Data Analytics.",
      },
    ]}
    image={{
      src: "https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=2070&q=80",
      alt: "Data and technology collaboration",
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Building Complete Data Solutions
      </h3>
      I work across the full data lifecycle — from ingestion and storage
      to processing, visualization, and intelligent applications.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>


  <!-- ===================================================== -->
  <!-- EXPERIENCE (single source of truth — no duplication) -->
  <!-- ===================================================== -->

  <section id="experience" class="py-16">
    <div class="max-w-6xl mx-auto px-4">

      <div class="text-center mb-12">
        <p class="text-blue-600 font-semibold uppercase tracking-wide">
          Professional Experience
        </p>
        <h2 class="text-4xl font-bold mt-2 dark:text-white">
          Internships & Industry Experience
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">

        <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 shadow-md">
          <div class="flex items-center gap-3 mb-3">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30">
              <iconify-icon icon="tabler:shield-check" class="text-blue-600" />
            </div>
            <span class="text-sm text-blue-600 font-semibold">07/2026 – 08/2026</span>
          </div>
          <h3 class="font-bold text-lg dark:text-white">AI & Data Scientist Intern</h3>
          <p class="text-sm text-gray-500 mt-1">
            Moroccan Center for Polytechnic Research and Innovation
          </p>
          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3">
            Built an end-to-end phishing detection pipeline: benchmarked 4 ML
            models (5-fold CV, 90%+ precision/recall) with Elasticsearch and a
            5-page Streamlit monitoring dashboard with automated alerts.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 shadow-md">
          <div class="flex items-center gap-3 mb-3">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30">
              <iconify-icon icon="tabler:chart-bar" class="text-blue-600" />
            </div>
            <span class="text-sm text-blue-600 font-semibold">07/2025 – 08/2025</span>
          </div>
          <h3 class="font-bold text-lg dark:text-white">Data Analyst Intern</h3>
          <p class="text-sm text-gray-500 mt-1">Terra Nova EBS</p>
          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3">
            Designed 4-page Power BI dashboards for Procurement, built DAX
            measures, and cleaned/transformed business datasets.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 shadow-md">
          <div class="flex items-center gap-3 mb-3">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30">
              <iconify-icon icon="tabler:building-hospital" class="text-blue-600" />
            </div>
            <span class="text-sm text-blue-600 font-semibold">06/2025 – 09/2025</span>
          </div>
          <h3 class="font-bold text-lg dark:text-white">Web Development Intern</h3>
          <p class="text-sm text-gray-500 mt-1">Provincial Hospital Center Med VI</p>
          <p class="text-sm text-gray-600 dark:text-gray-300 mt-3">
            Built admin and employee modules (PHP, MySQL, JavaScript) to
            digitalize the radiology department's operations.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- ===================================================== -->
  <!-- EDUCATION -->
  <!-- ===================================================== -->

  <section id="education" class="py-16 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-6xl mx-auto px-4">

      <h2 class="text-3xl font-bold text-center mb-3 dark:text-white">Education</h2>
      <p class="text-center text-gray-500 mb-12">
        My academic path in engineering, data, and computer science.
      </p>

      <div class="relative border-l-2 border-blue-600 dark:border-blue-400 ml-4">

        <div class="mb-12 ml-8 relative">
          <span class="absolute -left-[46px] top-0 flex items-center justify-center w-8 h-8 rounded-full bg-blue-600 ring-4 ring-gray-50 dark:ring-gray-900">
            <iconify-icon icon="tabler:school" class="text-white" />
          </span>
          <span class="text-sm text-blue-600 font-semibold">2024 – Present</span>
          <h3 class="text-xl font-bold mt-1 dark:text-white">Engineering Degree — Data Engineering</h3>
          <p class="font-medium text-gray-600 dark:text-gray-300">
            National School of Applied Sciences of Al Hoceima (ENSA Al Hoceima)
          </p>
          <p class="text-gray-500 dark:text-gray-400 mt-2">
            Final-year cycle: Data Engineering, Big Data, distributed systems,
            AI, Machine Learning, databases, and BI.
          </p>
        </div>

        <div class="mb-12 ml-8 relative">
          <span class="absolute -left-[46px] top-0 flex items-center justify-center w-8 h-8 rounded-full bg-purple-600 ring-4 ring-gray-50 dark:ring-gray-900">
            <iconify-icon icon="tabler:books" class="text-white" />
          </span>
          <span class="text-sm text-purple-600 font-semibold">2022 – 2024</span>
          <h3 class="text-xl font-bold mt-1 dark:text-white">Preparatory Cycle</h3>
          <p class="font-medium text-gray-600 dark:text-gray-300">
            National School of Applied Sciences of Al Hoceima (ENSA Al Hoceima)
          </p>
          <p class="text-gray-500 dark:text-gray-400 mt-2">
            Foundations in mathematics, programming, algorithms, and engineering.
          </p>
        </div>

        <div class="ml-8 relative">
          <span class="absolute -left-[46px] top-0 flex items-center justify-center w-8 h-8 rounded-full bg-pink-600 ring-4 ring-gray-50 dark:ring-gray-900">
            <iconify-icon icon="tabler:certificate" class="text-white" />
          </span>
          <span class="text-sm text-pink-600 font-semibold">2022</span>
          <h3 class="text-xl font-bold mt-1 dark:text-white">Baccalaureate — Physics & Chemistry</h3>
          <p class="font-medium text-gray-600 dark:text-gray-300">Lycée Rif, Ajdir (French option)</p>
        </div>

      </div>
    </div>
  </section>


  <!-- ===================================================== -->
  <!-- PROJECTS — Featured (rich) + More (compact) -->
  <!-- ===================================================== -->

  <!-- ===================================================== -->
  <!-- PROJECTS — Featured (rich) + More (compact) -->
  <!-- ===================================================== -->

  <section id="projects" class="py-20">
    <div class="max-w-6xl mx-auto px-4">

      <div class="text-center mb-12">
        <p class="text-blue-600 font-semibold uppercase tracking-wide">Portfolio</p>
        <h2 class="text-4xl md:text-5xl font-bold mt-2 dark:text-white">Featured Projects</h2>
        <p class="text-gray-500 max-w-3xl mx-auto mt-4">
          My strongest work in Data Engineering, Big Data, and Machine Learning.
        </p>
      </div>

      <!-- Featured: pick your strongest, most complete projects -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-xl transition-shadow overflow-hidden">
          <img src="/images/taasim.png" alt="TaaSim Urban Mobility Platform" class="w-full h-52 object-cover" />
          <div class="p-6">
            <h3 class="text-lg font-bold dark:text-white">TaaSim — Real-Time Urban Mobility</h3>
            <p class="text-sm text-blue-600 mt-2">Kafka • Flink • Spark • Cassandra • MinIO • Docker</p>
            <p class="text-gray-600 dark:text-gray-300 mt-3 text-sm">
              Kappa-architecture platform for real-time mobility data: Kafka
              ingestion, Flink streaming, and ML demand forecasting.
            </p>
            <div class="flex flex-wrap gap-3 mt-5">
              <a href="https://github.com/elghalbouni-oumaima/taasim-urban-mobility-platform" target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700">
                GitHub ↗
              </a>
              <a href="https://www.linkedin.com/feed/update/urn:li:activity:7475355956491563008/" target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border border-gray-300 dark:border-gray-600 px-4 py-2 rounded-lg text-sm hover:bg-gray-100 dark:hover:bg-gray-800">
                ▶ Demo
              </a>
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-xl transition-shadow overflow-hidden">
          <img src="/images/data-warehouse.png" alt="End-to-End Data Warehouse" class="w-full h-52 object-cover" />
          <div class="p-6">
            <h3 class="text-lg font-bold dark:text-white">Data Warehouse & Churn Analytics</h3>
            <p class="text-sm text-blue-600 mt-2">SQL Server • Power BI • FastAPI</p>
            <p class="text-gray-600 dark:text-gray-300 mt-3 text-sm">
              Bronze/Silver/Gold warehouse with 19 data-quality checks and a
              churn model at 97% recall, served via FastAPI + Power BI.
            </p>
            <div class="flex flex-wrap gap-3 mt-5">
              <a href="https://github.com/elghalbouni-oumaima/end-to-end-data-warehouse-with-sql" target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700">
                GitHub ↗
              </a>
              <button onclick="document.getElementById('churn-modal').classList.remove('hidden')"
                class="inline-flex items-center gap-2 border border-gray-300 dark:border-gray-600 px-4 py-2 rounded-lg text-sm hover:bg-gray-100 dark:hover:bg-gray-800">
                ▶ App Demo
              </button>
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-xl transition-shadow overflow-hidden">
          <img src="/images/mongodb.png" alt="FHV Trip Data Optimization" class="w-full h-52 object-cover" />
          <div class="p-6">
            <h3 class="text-lg font-bold dark:text-white">FHV Trip Data Optimization</h3>
            <p class="text-sm text-blue-600 mt-2">MongoDB • Python • Dash</p>
            <p class="text-gray-600 dark:text-gray-300 mt-3 text-sm">
              MongoDB indexing on 16M records: 61.8s → 7.8s query time.
            </p>
            <div class="flex flex-wrap gap-3 mt-5">
              <a href="https://github.com/elghalbouni-oumaima/fhv-tripdata-mongodb-optimization" target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700">
                GitHub ↗
              </a>
              <button onclick="document.getElementById('mongodb-video-modal').classList.remove('hidden')"
                class="inline-flex items-center gap-2 border border-gray-300 dark:border-gray-600 px-4 py-2 rounded-lg text-sm hover:bg-gray-100 dark:hover:bg-gray-800">
                ▶ Demo
              </button>
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-xl transition-shadow overflow-hidden">
          <img src="/images/power-bi-modeling.png" alt="Power BI Data Modeling" class="w-full h-52 object-cover" />
          <div class="p-6">
            <h3 class="text-lg font-bold dark:text-white">Power BI Data Modeling</h3>
            <p class="text-sm text-blue-600 mt-2">Power BI • Star Schema • DAX</p>
            <p class="text-gray-600 dark:text-gray-300 mt-3 text-sm">
              Rebuilt a "nightmare" dataset — 23+ disconnected, duplicated
              tables — into a clean, business-ready star schema.
            </p>
            <div class="flex flex-wrap gap-3 mt-5">
              <a href="https://github.com/elghalbouni-oumaima/power-bi-data-modeling" target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700">
                GitHub ↗
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Section divider — intentional break instead of raw whitespace -->
      <div class="border-t border-gray-200 dark:border-gray-800 mt-16 pt-16">
        <h3 class="text-2xl font-bold text-center mb-8 dark:text-white">More Projects</h3>

        <div class="grid md:grid-cols-2 gap-4">

          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-gray-900 shadow-md hover:shadow-lg transition-shadow">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30 shrink-0">
              <iconify-icon icon="tabler:message-2" class="text-blue-600" />
            </div>
            <div>
              <h4 class="font-semibold dark:text-white">AI Meeting Assistant</h4>
              <p class="text-sm text-gray-500 mt-1">RAG + FAISS meeting summarizer, action items, and Q&A over transcripts.</p>
              <a href="https://github.com/elghalbouni-oumaima/meeting-assistant" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline mt-1 inline-block">GitHub ↗</a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-gray-900 shadow-md hover:shadow-lg transition-shadow">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30 shrink-0">
              <iconify-icon icon="tabler:briefcase" class="text-blue-600" />
            </div>
            <div>
              <h4 class="font-semibold dark:text-white">JobIntelligent — Job Data Platform</h4>
              <p class="text-sm text-gray-500 mt-1">Multi-API aggregation, MinIO + PostgreSQL storage, Power BI dashboards.</p>
              <div class="flex gap-3 mt-1">
                <a href="https://github.com/elghalbouni-oumaima/JobIntelligent-Data-Platform" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline">GitHub ↗</a>
                <a href="https://www.linkedin.com/feed/update/urn:li:activity:7474995890563395584/" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline">▶ Demo</a>
              </div>
            </div>
          </div>

          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-gray-900 shadow-md hover:shadow-lg transition-shadow">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30 shrink-0">
              <iconify-icon icon="tabler:hand-stop" class="text-blue-600" />
            </div>
            <div>
              <h4 class="font-semibold dark:text-white">Sign Language Translation</h4>
              <p class="text-sm text-gray-500 mt-1">Deep learning on Phoenix-2014T: 399 keypoints, sequence-based recognition.</p>
              <a href="https://github.com/elghalbouni-oumaima/sign-language-translation" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline mt-1 inline-block">GitHub ↗</a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-gray-900 shadow-md hover:shadow-lg transition-shadow">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30 shrink-0">
              <iconify-icon icon="tabler:stethoscope" class="text-blue-600" />
            </div>
            <div>
              <h4 class="font-semibold dark:text-white">Medical Data Management System</h4>
              <p class="text-sm text-gray-500 mt-1">Patient data management and statistical insights (Python, MySQL, PHP).</p>
              <a href="https://github.com/elghalbouni-oumaima/disease-management-system" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline mt-1 inline-block">GitHub ↗</a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-gray-900 shadow-md hover:shadow-lg transition-shadow">
            <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30 shrink-0">
              <iconify-icon icon="tabler:cloud-rain" class="text-blue-600" />
            </div>
            <div>
              <h4 class="font-semibold dark:text-white">Weather Application</h4>
              <p class="text-sm text-gray-500 mt-1">Desktop app (PyQt5) with live weather data and city search.</p>
              <a href="https://github.com/elghalbouni-oumaima/Weather-Application" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline mt-1 inline-block">GitHub ↗</a>
              <button onclick="document.getElementById('weather-app-modal').classList.remove('hidden')"
                class="text-sm text-blue-600 hover:underline">
                ▶ Demo
              </button>
            </div>
          </div>

          <!-- No public link yet — labeled honestly instead of a dead-end card -->
          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-gray-900 shadow-md hover:shadow-lg transition-shadow opacity-80">
            <div class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 shrink-0">
              <iconify-icon icon="tabler:server-2" class="text-gray-500" />
            </div>
            <div>
              <h4 class="font-semibold dark:text-white">Procurement Data Pipeline</h4>
              <p class="text-sm text-gray-500 mt-1">Batch pipeline with HDFS, Hive, Trino, and Parquet — private repo.</p>
              <a href="https://github.com/elghalbouni-oumaima/batch-procurement-data-pipeline" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline mt-1 inline-block">GitHub ↗</a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-gray-900 shadow-md hover:shadow-lg transition-shadow opacity-80">
            <div class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 shrink-0">
              <iconify-icon icon="tabler:tags" class="text-gray-500" />
            </div>
            <div>
              <h4 class="font-semibold dark:text-white">NLP Annotation Platform</h4>
              <p class="text-sm text-gray-500 mt-1">Spring Boot annotation workflow tool with role-based access — private repo.</p>
              <a href="https://github.com/elghalbouni-oumaima/nlp-annotation-platform" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline mt-1 inline-block">GitHub ↗</a>
              <button onclick="document.getElementById('nlp-annotation-platform-modal').classList.remove('hidden')"
                class="inline-flex items-center gap-2 border border-gray-300 dark:border-gray-600 px-4 py-2 rounded-lg text-sm hover:bg-gray-100 dark:hover:bg-gray-800">
                ▶ Demo
              </button>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- ===================================================== -->
  <!-- MONGODB VIDEO MODAL -->
  <!-- ===================================================== -->

  <div id="mongodb-video-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 px-4">
    <div class="relative w-full max-w-4xl bg-black rounded-2xl overflow-hidden shadow-2xl">
      <button
        onclick="document.getElementById('mongodb-video-modal').classList.add('hidden')"
        class="absolute top-3 right-3 z-10 w-10 h-10 rounded-full bg-black/70 text-white text-xl hover:bg-gray-800 transition"
        aria-label="Close video"
      >
        ✕
      </button>
      <video class="w-full aspect-video" controls preload="metadata">
        <source src="/videos/mongodb-demo.mp4" type="video/mp4" />
        Your browser does not support the video element.
      </video>
    </div>
  </div>

  <div id="churn-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 px-4">
    <div class="relative w-full max-w-4xl bg-black rounded-2xl overflow-hidden shadow-2xl">
      <button
        onclick="document.getElementById('churn-modal').classList.add('hidden')"
        class="absolute top-3 right-3 z-10 w-10 h-10 rounded-full bg-black/70 text-white text-xl hover:bg-gray-800 transition"
